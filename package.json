{
  "name": "xj-core",
  "version": "0.0.7",
  "description": "",
  "type": "module",
  "workspaces": [
    "packages/*",
    "scripts",
    "docs",
    "example"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "release": "tsx scripts/release.ts",
    "lint": "eslint --cache",
    "format": "prettier --write \"{packages,scripts,tests}/**/*.{ts,mjs,json,md}\"",
    "format-check": "prettier --check \"{packages,scripts,tests}/**/*.{ts,mjs,json,md}\"",
    "test": "tsx scripts/test.ts",
    "test-ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "link-packages": "lerna link",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "bin": {
    "xj-clean": "./scripts/clean.js"
  },
  "keywords": [
    "xj",
    "xj-fv"
  ],
  "bugs": {
    "url": "https://github.com/XunJiJiang/XJ/issues"
  },
  "homepage": "https://github.com/XunJiJiang/XJ#readme",
  "author": "XunJiJiang",
  "license": "MIT",
  "devDependencies": {
    "@babel/preset-react": "^7.26.3",
    "@eslint/js": "^9.17.0",
    "@inquirer/prompts": "^7.2.0",
    "@tsconfig/node20": "^20.1.6",
    "@types/node": "^24.9.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "chalk": "^5.3.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.2.5",
    "prettier": "3.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^7.1.11",
    "vitest": "^3.2.4"
  }
}
